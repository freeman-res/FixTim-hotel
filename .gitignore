# ============================================================
# Данные (НЕ коммитим сырые датасеты и производные большие файлы)
# ============================================================
# Сырые CSV — весят десятки МБ, лежат вне репо
data/raw/*.csv
data/raw/**/*.csv
data/raw/*.json
data/raw/**/*.json
!data/raw/.gitkeep

# Производные JSON — воспроизводятся из raw через import_data.py
# НО: их отсутствие ломает "git clone && python scripts/import_data.py"
# Решение: коммитим (это манифест + демо-данные для защиты)
# Если решишь НЕ коммитить — раскомментируй:
# data/demo/*.json
# data/normalized/*.json

# Векторный индекс — генерируется build_rag_index.py, зависит от BGE-M3
data/vector_index/
!data/vector_index/.gitkeep

# Временные файлы записи (см. atomic write в import_data.py)
*.json.tmp

# ============================================================
# Модели и веса (не коммитим никогда)
# ============================================================
*.pt
*.pth
*.bin
*.safetensors
models/
.cache/
huggingface/

# ============================================================
