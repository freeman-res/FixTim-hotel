APP_NAME=Hotel AI Agent Backend
APP_VERSION=0.1.0
DEBUG=false
DATABASE_URL=sqlite:///./hotel_agent.db

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_NUM_CTX=8192

RZD_CONNECT_TIMEOUT=3
RZD_READ_TIMEOUT=12
RZD_RETRY_TOTAL=0
RZD_CA_BUNDLE=

CATALOG_PROVIDER=json
CATALOG_DATA_DIR=./data/catalog
CATALOG_RAG_INDEX_DIR=./data/vector_index
CATALOG_SOURCE_DIR=./datasets

CATALOG_CLIMATE_ENABLED=1


TUTU_MCP_ENABLED=true
TUTU_MCP_URL=https://mcp.tutu.ru/mcp
TUTU_MCP_TIMEOUT=20
OSRM_URL=https://router.project-osrm.org

WEATHERBIT_KEY=
WEATHERAPI_KEY=
